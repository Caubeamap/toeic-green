# BACKEND SERVER CONFIGURATION
PORT=2409
FRONTEND_URL=http://localhost:6868

# DATABASE CONFIGURATION (PostgreSQL)
# For local dev using docker-compose:
DATABASE_URL="postgresql://toeic_admin:toeic_secure_pwd_2026@localhost:5432/toeic_green?schema=public"
# For Supabase (Production):
# DATABASE_URL="postgresql://postgres.[your-project-id]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# CACHE CONFIGURATION (Redis)
# For local dev using docker-compose:
REDIS_URL="redis://localhost:6379"
# For Upstash (Production):
# REDIS_URL="rediss://default:[your-password]@[your-instance].upstash.io:6379"

# JWT CONFIGURATION (Min 32 characters, must be unique & NOT the placeholder)
JWT_SECRET="your_very_long_jwt_access_secret_key_2026"
JWT_REFRESH_SECRET="your_very_long_jwt_refresh_secret_key_2026"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# PRODUCTION HARDENING
# Trusted proxy hops so the real client IP is read from X-Forwarded-For. Set to 1
# behind a single CDN/reverse proxy (Cloudflare/Nginx/Render). Leave unset locally
# (no proxy) to avoid X-Forwarded-For spoofing. Without this, the rate limiter keys
# every user to the proxy IP and blocks legitimate traffic at scale.
# TRUST_PROXY="1"
# Force the refresh-token cookie `Secure` flag explicitly instead of relying on
# NODE_ENV. Set "true" on any HTTPS deployment (incl. staging/preview).
# COOKIE_SECURE="true"

# EMAIL VERIFICATION
MAIL_PROVIDER="smtp" # smtp for Gmail demo; resend after verifying a domain
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-demo-account@gmail.com"
SMTP_APP_PASSWORD="your-16-character-google-app-password"
EMAIL_FROM="TOEIC Green <your-demo-account@gmail.com>"
EMAIL_VERIFICATION_URL="http://localhost:6868/verify-email"

# FUTURE RESEND PRODUCTION PROVIDER
RESEND_API_KEY="re_your_resend_api_key"

# OAUTH - GOOGLE
GOOGLE_CLIENT_ID="google-oauth-client-id"
GOOGLE_CLIENT_SECRET="google-oauth-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:2409/api/auth/google/callback"

# OAUTH - GITHUB
GITHUB_CLIENT_ID="github-oauth-client-id"
GITHUB_CLIENT_SECRET="github-oauth-client-secret"
GITHUB_CALLBACK_URL="http://localhost:2409/api/auth/github/callback"

# CLOUDFLARE R2 FILE STORAGE
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY="your-r2-access-key-id"
R2_SECRET_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="toeic-green-assets"
R2_PUBLIC_URL="https://assets.toeicgreen.com" # Or Cloudflare public dev endpoint
