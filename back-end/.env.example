# BACKEND SERVER CONFIGURATION
PORT=3001
FRONTEND_URL=http://localhost:3000

# DATABASE CONFIGURATION (PostgreSQL)
# For local dev using docker-compose:
DATABASE_URL="postgresql://toeic_admin:toeic_secure_pwd_2026@localhost:5432/toeic_green?schema=public"
# For Supabase (Production):
# DATABASE_URL="postgresql://postgres.[your-project-id]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# CACHE CONFIGURATION (Redis)
# For local dev using docker-compose:
REDIS_URL="redis://localhost:6379"
# For Upstash (Production):
# REDIS_URL="rediss://default:[your-password]@[your-instance].upstash.io:6379"

# JWT CONFIGURATION (Min 32 characters)
JWT_SECRET="your_very_long_jwt_access_secret_key_2026"
JWT_REFRESH_SECRET="your_very_long_jwt_refresh_secret_key_2026"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# OAUTH - GOOGLE
GOOGLE_CLIENT_ID="google-oauth-client-id"
GOOGLE_CLIENT_SECRET="google-oauth-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# OAUTH - GITHUB
GITHUB_CLIENT_ID="github-oauth-client-id"
GITHUB_CLIENT_SECRET="github-oauth-client-secret"
GITHUB_CALLBACK_URL="http://localhost:3001/api/auth/github/callback"

# CLOUDFLARE R2 FILE STORAGE
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY="your-r2-access-key-id"
R2_SECRET_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="toeic-green-assets"
R2_PUBLIC_URL="https://assets.toeicgreen.com" # Or Cloudflare public dev endpoint
